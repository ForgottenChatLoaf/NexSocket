<?xml version="1.0" encoding="utf-8"?>
<!--
  NexSocket Brand Launcher Icon — Foreground Layer
  Emerald power icon (matches the outlet-card power SVG in the web UI)
  Renders on top of the Obsidian background, within the 72dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Power icon: circle arc (270° of a circle) + vertical line
      Centered at (54, 54) in the 72dp safe zone.
      strokeWidth chosen so it reads cleanly at all icon sizes.
    -->

    <!-- Emerald power circle arc — strokeWidth 7 at 108dp viewport -->
    <path
        android:pathData="M54,27 L54,54"
        android:strokeColor="#10B981"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!--
      Arc: a 270° circle arc centred at (54,54) with radius 21.
      SVG-style arc path for the open-top power ring.
      Opens at the top (12 o'clock), arcs clockwise around the bottom.
      Start  = (54, 33)   → 12 o'clock top (open gap)
      We draw from ~40° to ~320° (leaving ~40° gap at the top).
    -->
    <path
        android:pathData="
          M37.5,38.5
          A21,21 0 1 0 70.5,38.5"
        android:strokeColor="#10B981"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

</vector>
